{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "AQ_GRAPHICS_API": "D3D12"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows / Visual Studio 2026 (v145)",
      "description": "VS プロジェクトを生成する。既存 DirectX.sln とは別物なので上書きしない。",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64"
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows / Visual Studio 2022 (v143)",
      "description": "VS2026 が無い環境向け。",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "host=x64"
    },
    {
      "name": "windows-clang-cl",
      "displayName": "Windows / clang-cl (Ninja Multi-Config)",
      "description": "MSVC 拡張依存を潰すための可搬性検証用。x64 Native Tools コマンドプロンプトから実行すること。",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "macos-ninja",
      "displayName": "macOS / Ninja Multi-Config (Vulkan + MoltenVK)",
      "description": "P2 で検証する。Vulkan SDK for macOS が必要。",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "AQ_GRAPHICS_API": "Vulkan"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-xcode",
      "displayName": "macOS / Xcode (Vulkan + MoltenVK)",
      "description": "P2 で検証する。Vulkan SDK for macOS が必要。",
      "inherits": "macos-ninja",
      "generator": "Xcode"
    },
    {
      "name": "macos-ninja-metal",
      "displayName": "macOS / Ninja Multi-Config (ネイティブ Metal)",
      "description": "設計書/MetalBackend設計.md の P6。dxc と spirv-cross を使うため Vulkan SDK が必要。",
      "inherits": "macos-ninja",
      "cacheVariables": {
        "AQ_GRAPHICS_API": "Metal"
      }
    },
    {
      "name": "macos-xcode-metal",
      "displayName": "macOS / Xcode (ネイティブ Metal)",
      "description": "設計書/MetalBackend設計.md の P6。",
      "inherits": "macos-ninja-metal",
      "generator": "Xcode"
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "AQ_GRAPHICS_API": "Metal",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.4"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ios-simulator-xcode",
      "displayName": "iOS シミュレータ / Xcode (ネイティブ Metal)",
      "description": "設計書/iOS移植設計.md の P0〜P4 の主経路。署名不要で simctl から実行できる。デプロイターゲット 16.4 は BC 圧縮テクスチャの API が入ったバージョン(§2.2)。",
      "inherits": "ios-base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO"
      }
    },
    {
      "name": "ios-xcode",
      "displayName": "iOS 実機 / Xcode (ネイティブ Metal)",
      "description": "実機向け(P5)。インストールには署名が要るので DEVELOPMENT_TEAM を別途指定すること。",
      "inherits": "ios-base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos"
      }
    },
    {
      "name": "ios-ninja",
      "displayName": "iOS シミュレータ / Ninja Multi-Config (ネイティブ Metal)",
      "description": "コンパイルエラーの潰し込み用。実行と署名は Xcode ジェネレータ側で行う。",
      "inherits": "ios-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "AQ_GRAPHICS_API": "Vulkan",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_PLATFORM": "android-33",
        "ANDROID_STL": "c++_static",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android / arm64-v8a (Ninja Multi-Config, Vulkan)",
      "description": "実機向け。環境変数 ANDROID_NDK_HOME に NDK r26 以降のパスが必要。android-33 は Vulkan 1.3 の下限(Android 13)。",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android / x86_64 (エミュレータ)",
      "description": "エミュレータ向け。Vulkan の機能・性能は実機と一致しないので判定には使わない。",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-cl-debug",
      "configurePreset": "windows-clang-cl",
      "configuration": "Debug"
    },
    {
      "name": "windows-clang-cl-release",
      "configurePreset": "windows-clang-cl",
      "configuration": "Release"
    },
    {
      "name": "macos-ninja-debug",
      "configurePreset": "macos-ninja",
      "configuration": "Debug"
    },
    {
      "name": "macos-ninja-release",
      "configurePreset": "macos-ninja",
      "configuration": "Release"
    },
    {
      "name": "macos-xcode-debug",
      "configurePreset": "macos-xcode",
      "configuration": "Debug"
    },
    {
      "name": "macos-xcode-release",
      "configurePreset": "macos-xcode",
      "configuration": "Release"
    },
    {
      "name": "macos-ninja-metal-debug",
      "configurePreset": "macos-ninja-metal",
      "configuration": "Debug"
    },
    {
      "name": "macos-ninja-metal-release",
      "configurePreset": "macos-ninja-metal",
      "configuration": "Release"
    },
    {
      "name": "macos-xcode-metal-debug",
      "configurePreset": "macos-xcode-metal",
      "configuration": "Debug"
    },
    {
      "name": "macos-xcode-metal-release",
      "configurePreset": "macos-xcode-metal",
      "configuration": "Release"
    },
    {
      "name": "ios-simulator-xcode-debug",
      "configurePreset": "ios-simulator-xcode",
      "configuration": "Debug"
    },
    {
      "name": "ios-simulator-xcode-release",
      "configurePreset": "ios-simulator-xcode",
      "configuration": "Release"
    },
    {
      "name": "ios-xcode-debug",
      "configurePreset": "ios-xcode",
      "configuration": "Debug"
    },
    {
      "name": "ios-xcode-release",
      "configurePreset": "ios-xcode",
      "configuration": "Release"
    },
    {
      "name": "ios-ninja-debug",
      "configurePreset": "ios-ninja",
      "configuration": "Debug"
    },
    {
      "name": "ios-ninja-release",
      "configurePreset": "ios-ninja",
      "configuration": "Release"
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64",
      "configuration": "Debug"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64",
      "configuration": "Release"
    },
    {
      "name": "android-x86_64-debug",
      "configurePreset": "android-x86_64",
      "configuration": "Debug"
    },
    {
      "name": "android-x86_64-release",
      "configurePreset": "android-x86_64",
      "configuration": "Release"
    }
  ]
}
